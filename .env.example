# Application
APP_ENV=development
APP_DEBUG=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/kalshi_edge.db

# Kalshi API (Phase 2)
KALSHI_API_KEY=
KALSHI_PRIVATE_KEY=
KALSHI_USE_DEMO=true

# LLM (provider: anthropic, openai, or gemini)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=

# External APIs
OPENWEATHER_API_KEY=
FRED_API_KEY=
ODDS_API_KEY=
TAVILY_API_KEY=

# Strategy defaults
EDGE_THRESHOLD=0.20
MIN_MULTIPLIER=2.0
MAX_DAYS_TO_CLOSE=7
MIN_VOLUME=100
MAX_BET_AMOUNT=100.0
SCAN_INTERVAL_HOURS=1
AUTO_EXECUTE_STRENGTH=strong
